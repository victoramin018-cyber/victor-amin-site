# =============================================================================
# Variáveis de ambiente da API /api/lead — copie para .env.local em dev,
# e configure em Vercel → Project → Settings → Environment Variables em prod.
# =============================================================================

# -----------------------------------------------------------------------------
# Meta · Pixel + Conversions API
# -----------------------------------------------------------------------------
META_PIXEL_ID=465701309646610
# Gerar em: Events Manager → seu Pixel → Settings → "Generate access token"
META_CAPI_ACCESS_TOKEN=
# Opcional · só pra debug em Test Events tab. Deixar vazio em produção.
META_CAPI_TEST_EVENT_CODE=

# -----------------------------------------------------------------------------
# Kommo CRM · cria Lead via API REST v4
# -----------------------------------------------------------------------------
KOMMO_SUBDOMAIN=victoramin018
# Long-lived token (Settings → Integrações → Criar integração → 5 anos)
KOMMO_LONG_LIVED_TOKEN=

# (opcionais · se não setados, lead vai pro pipeline default no primeiro stage)
# Pegar via: GET https://victoramin018.kommo.com/api/v4/leads/pipelines
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=

# (opcionais · se não setados, respostas qualificadoras viram Note no Lead)
# Pegar via: GET https://victoramin018.kommo.com/api/v4/leads/custom_fields
KOMMO_CF_IDADE_ID=
KOMMO_CF_OBJETIVO_ID=
KOMMO_CF_EXPERIENCIA_ID=
KOMMO_CF_INVESTIMENTO_ID=
KOMMO_CF_URGENCIA_ID=
KOMMO_CF_RESTRICAO_ID=
KOMMO_CF_MOTIVO_ID=

# -----------------------------------------------------------------------------
# Resend · email confirmação para o lead (Sprint 3+ · opcional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
